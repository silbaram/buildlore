{
  "name": "buildlore",
  "version": "0.1.1-rc.1",
  "description": "Local-first, Git-backed development wiki tooling",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11 <12"
  },
  "bin": {
    "buildlore": "./dist/cli/bin.js"
  },
  "exports": {
    "./schemas/project-knowledge-completeness.schema.json": "./schemas/project-knowledge-completeness.schema.json",
    "./schemas/project-knowledge-change-impact.schema.json": "./schemas/project-knowledge-change-impact.schema.json",
    "./schemas/project-knowledge-history.schema.json": "./schemas/project-knowledge-history.schema.json",
    "./schemas/project-knowledge-reader.schema.json": "./schemas/project-knowledge-reader.schema.json",
    "./schemas/project-knowledge-answers.schema.json": "./schemas/project-knowledge-answers.schema.json",
    "./schemas/project-knowledge.schema.json": "./schemas/project-knowledge.schema.json",
    "./schemas/project-knowledge-workflow.schema.json": "./schemas/project-knowledge-workflow.schema.json",
    "./schemas/project-knowledge-inspection.schema.json": "./schemas/project-knowledge-inspection.schema.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/source-document.schema.json": "./schemas/source-document.schema.json",
    "./schemas/source-document-v2.schema.json": "./schemas/source-document-v2.schema.json",
    "./schemas/source-document-v3.schema.json": "./schemas/source-document-v3.schema.json",
    "./schemas/source-descriptor.schema.json": "./schemas/source-descriptor.schema.json",
    "./schemas/source-descriptor-v2.schema.json": "./schemas/source-descriptor-v2.schema.json",
    "./schemas/json-extraction-profile.schema.json": "./schemas/json-extraction-profile.schema.json",
    "./schemas/source-metadata.schema.json": "./schemas/source-metadata.schema.json",
    "./schemas/lifecycle-profile.schema.json": "./schemas/lifecycle-profile.schema.json",
    "./schemas/retrieval-corpus.schema.json": "./schemas/retrieval-corpus.schema.json",
    "./schemas/retrieval-evaluation.schema.json": "./schemas/retrieval-evaluation.schema.json",
    "./schemas/knowledge-tracking-policy.schema.json": "./schemas/knowledge-tracking-policy.schema.json",
    "./schemas/knowledge-publish-plan.schema.json": "./schemas/knowledge-publish-plan.schema.json",
    "./schemas/knowledge-publish-result.schema.json": "./schemas/knowledge-publish-result.schema.json",
    "./schemas/knowledge-commit-lineage.schema.json": "./schemas/knowledge-commit-lineage.schema.json",
    "./schemas/knowledge-parent-pin-plan.schema.json": "./schemas/knowledge-parent-pin-plan.schema.json",
    "./schemas/knowledge-parent-pin-result.schema.json": "./schemas/knowledge-parent-pin-result.schema.json",
    "./schemas/local-project-registry.schema.json": "./schemas/local-project-registry.schema.json",
    "./schemas/source-collection-manifest.schema.json": "./schemas/source-collection-manifest.schema.json",
    "./schemas/source-collection-manifest-v2.schema.json": "./schemas/source-collection-manifest-v2.schema.json",
    "./schemas/profile-binding.schema.json": "./schemas/profile-binding.schema.json",
    "./schemas/profile-binding-v2.schema.json": "./schemas/profile-binding-v2.schema.json",
    "./schemas/wiki-export.schema.json": "./schemas/wiki-export.schema.json",
    "./schemas/compile-plan.schema.json": "./schemas/compile-plan.schema.json",
    "./schemas/compile-proposal.schema.json": "./schemas/compile-proposal.schema.json",
    "./schemas/compile-apply-result.schema.json": "./schemas/compile-apply-result.schema.json",
    "./schemas/session-compile-provenance.schema.json": "./schemas/session-compile-provenance.schema.json",
    "./schemas/session-review-candidate.schema.json": "./schemas/session-review-candidate.schema.json",
    "./schemas/session-candidate-list.schema.json": "./schemas/session-candidate-list.schema.json",
    "./schemas/session-candidate-approval.schema.json": "./schemas/session-candidate-approval.schema.json",
    "./schemas/session-promotion-proof.schema.json": "./schemas/session-promotion-proof.schema.json",
    "./schemas/hierarchical-corpus.schema.json": "./schemas/hierarchical-corpus.schema.json",
    "./schemas/hierarchical-current-session.schema.json": "./schemas/hierarchical-current-session.schema.json",
    "./schemas/hierarchical-workflow.schema.json": "./schemas/hierarchical-workflow.schema.json",
    "./schemas/hierarchical-wiki-activation.schema.json": "./schemas/hierarchical-wiki-activation.schema.json",
    "./schemas/hierarchical-markdown-materialization.schema.json": "./schemas/hierarchical-markdown-materialization.schema.json",
    "./schemas/hierarchical-retrieval.schema.json": "./schemas/hierarchical-retrieval.schema.json",
    "./schemas/local-embedding.schema.json": "./schemas/local-embedding.schema.json",
    "./schemas/llm-wiki-retrieval-evaluation.schema.json": "./schemas/llm-wiki-retrieval-evaluation.schema.json",
    "./schemas/semantic-index.schema.json": "./schemas/semantic-index.schema.json",
    "./schemas/retrieval-result-v2.schema.json": "./schemas/retrieval-result-v2.schema.json",
    "./schemas/retrieval-result-v3.schema.json": "./schemas/retrieval-result-v3.schema.json",
    "./profiles/buildlore.profile.v1.json": "./profiles/buildlore.profile.v1.json",
    "./schemas/connection.schema.json": "./schemas/connection.schema.json",
    "./schemas/read-connections.schema.json": "./schemas/read-connections.schema.json",
    "./schemas/cli-envelope-v2.schema.json": "./schemas/cli-envelope-v2.schema.json",
    "./schemas/connection-status.schema.json": "./schemas/connection-status.schema.json",
    "./connection": {
      "types": "./dist/connection/index.d.ts",
      "import": "./dist/connection/index.js"
    },
    "./wiki-read": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js"
    },
    "./schemas/hub-relocation-plan.schema.json": "./schemas/hub-relocation-plan.schema.json",
    "./schemas/knowledge-workspace.schema.json": "./schemas/knowledge-workspace.schema.json",
    "./schemas/connection-v2.schema.json": "./schemas/connection-v2.schema.json",
    "./schemas/read-connections-v2.schema.json": "./schemas/read-connections-v2.schema.json",
    "./schemas/connection-status-v2.schema.json": "./schemas/connection-status-v2.schema.json",
    "./schemas/workspace-publish-plan.schema.json": "./schemas/workspace-publish-plan.schema.json",
    "./schemas/workspace-publish-result.schema.json": "./schemas/workspace-publish-result.schema.json",
    "./schemas/workspace-guide.schema.json": "./schemas/workspace-guide.schema.json",
    "./schemas/project-wiki.schema.json": "./schemas/project-wiki.schema.json",
    "./schemas/workspace-setup.schema.json": "./schemas/workspace-setup.schema.json",
    "./schemas/source-document-v4.schema.json": "./schemas/source-document-v4.schema.json",
    "./schemas/resource-budget.schema.json": "./schemas/resource-budget.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "profiles",
    "skills",
    "RELEASE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "eval:retrieval": "npm run build --silent && node dist/retrieval/evaluation/cli.js",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "p2a:init": "node scripts/bootstrap-p2a.mjs",
    "verify:installed-read": "node scripts/verify-installed-read.mjs",
    "verify:installed-workspace": "node scripts/verify-installed-workspace.mjs",
    "prepack": "node scripts/build.mjs",
    "pack:local": "node scripts/pack-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "4.2.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "jsonc-parser": "3.3.1",
    "llm-wiki-compiler": "1.1.0",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silbaram/buildlore.git"
  },
  "bugs": {
    "url": "https://github.com/silbaram/buildlore/issues"
  },
  "homepage": "https://github.com/silbaram/buildlore#readme"
}

# Plan2Agent local harness state and artifacts
# Planning artifacts, run logs, proposals, and generated harness files are local state.
# Persist them through Plan2Agent Memory instead of committing them with application source.
.plan2agent/

# Local plans, architecture records, and P2A source snapshots
# Keep these files in the local workspace or project knowledge repository, not in Git.
plans/

# Dependencies / build outputs
node_modules/
.test-tmp/
build/
dist/
out/
target/
.gradle/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Env / secrets
.env
.env.*
!.env.example

# Claude Code local machine settings
.claude/settings.local.json

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/project-knowledge-workflow.schema.json",
  "title": "Opt-in project knowledge current-session workflow",
  "description": "No AI process is launched. Independent review artifacts are imported. Runtime additionally enforces phase consistency, expected digests, sanitizer capability and current source/authority bindings.",
  "oneOf": [
    {
      "$ref": "project-knowledge-completeness.schema.json#/$defs/purpose"
    },
    {
      "$ref": "project-knowledge-completeness.schema.json#/$defs/run"
    },
    {
      "$ref": "project-knowledge-completeness.schema.json#/$defs/status"
    },
    {
      "$ref": "#/$defs/purpose"
    },
    {
      "$ref": "#/$defs/exchange"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/questionSubmission"
    },
    {
      "$ref": "project-knowledge-inspection.schema.json"
    }
  ],
  "$defs": {
    "authoringQuestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "role",
          "requirements"
        ],
        "properties": {
          "id": {
            "$ref": "project-knowledge.schema.json#/$defs/identifier"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "enum": [
              "overview",
              "architecture",
              "decisions"
            ]
          },
          "requirements": {
            "type": "array",
            "minItems": 0,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sourceRef",
                "jsonPointer",
                "contentKind"
              ],
              "properties": {
                "id": {
                  "$ref": "project-knowledge.schema.json#/$defs/identifier"
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "jsonPointer": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "contentKind": {
                  "enum": [
                    "any",
                    "json-value",
                    "text"
                  ]
                }
              }
            }
          },
          "contentProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "axis"
            ],
            "properties": {
              "id": {
                "const": "development-memory-v1"
              },
              "axis": {
                "enum": [
                  "purpose",
                  "architecture",
                  "decisions",
                  "current-state",
                  "failures-open-work"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "contentProfile"
              ]
            },
            "else": {
              "properties": {
                "requirements": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "contentProfile"
              ],
              "properties": {
                "contentProfile": {
                  "properties": {
                    "axis": {
                      "const": "purpose"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "overview"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "contentProfile"
              ],
              "properties": {
                "contentProfile": {
                  "properties": {
                    "axis": {
                      "const": "architecture"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "architecture"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "contentProfile"
              ],
              "properties": {
                "contentProfile": {
                  "properties": {
                    "axis": {
                      "const": "decisions"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "decisions"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "contentProfile"
              ],
              "properties": {
                "contentProfile": {
                  "properties": {
                    "axis": {
                      "const": "current-state"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "overview"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "contentProfile"
              ],
              "properties": {
                "contentProfile": {
                  "properties": {
                    "axis": {
                      "const": "failures-open-work"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "role": {
                  "const": "decisions"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "if": {
            "contains": {
              "required": [
                "contentProfile"
              ]
            }
          },
          "then": {
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "required": [
                "contentProfile"
              ]
            },
            "allOf": [
              {
                "contains": {
                  "required": [
                    "contentProfile"
                  ],
                  "properties": {
                    "contentProfile": {
                      "properties": {
                        "axis": {
                          "const": "purpose"
                        }
                      }
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "required": [
                    "contentProfile"
                  ],
                  "properties": {
                    "contentProfile": {
                      "properties": {
                        "axis": {
                          "const": "architecture"
                        }
                      }
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "required": [
                    "contentProfile"
                  ],
                  "properties": {
                    "contentProfile": {
                      "properties": {
                        "axis": {
                          "const": "decisions"
                        }
                      }
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "required": [
                    "contentProfile"
                  ],
                  "properties": {
                    "contentProfile": {
                      "properties": {
                        "axis": {
                          "const": "current-state"
                        }
                      }
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "required": [
                    "contentProfile"
                  ],
                  "properties": {
                    "contentProfile": {
                      "properties": {
                        "axis": {
                          "const": "failures-open-work"
                        }
                      }
                    }
                  }
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      ]
    },
    "questionAnswers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claimIds"
        ],
        "properties": {
          "id": {
            "$ref": "project-knowledge.schema.json#/$defs/identifier"
          },
          "claimIds": {
            "type": "array",
            "minItems": 0,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "project-knowledge.schema.json#/$defs/identifier"
            }
          }
        }
      },
      "description": "Runtime resolves every answer against the frozen question set. Empty claimIds are valid only for a development-memory-v1 axis with empty requirements; such an axis must map zero claims. Ordinary and selected-axis answers must be non-empty."
    },
    "questionSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "proposal",
        "questionAnswers"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-question-submission.v1"
        },
        "projectId": {
          "$ref": "#/$defs/purpose/properties/projectId"
        },
        "proposal": {
          "$ref": "project-knowledge.schema.json#/$defs/proposal"
        },
        "questionAnswers": {
          "$ref": "#/$defs/questionAnswers"
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "generationModel",
        "outputLanguage"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "buildlore.hierarchical-workflow-purpose-input.v2",
            "buildlore.hierarchical-workflow-purpose-input.v3"
          ]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "generationModel": {
          "const": "project-knowledge-v1"
        },
        "authoringQuestions": {
          "$ref": "#/$defs/authoringQuestions"
        },
        "outputLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": "buildlore.hierarchical-workflow-purpose-input.v3"
              }
            }
          },
          "then": {
            "required": [
              "authoringQuestions"
            ]
          },
          "else": {
            "not": {
              "required": [
                "authoringQuestions"
              ]
            }
          }
        }
      ]
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "snapshot",
        "baselineGenerationDigest",
        "previousRecords",
        "previousEvidence",
        "instructions",
        "boundary",
        "exchangeDigest"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "buildlore.knowledge-exchange.v1",
            "buildlore.knowledge-exchange.v2"
          ]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "authoringQuestions": {
          "$ref": "#/$defs/authoringQuestions"
        },
        "snapshot": {
          "$ref": "project-knowledge.schema.json#/$defs/snapshot"
        },
        "baselineGenerationDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-knowledge.schema.json#/$defs/digest"
            }
          ]
        },
        "previousRecords": {
          "type": "array",
          "items": {
            "$ref": "project-knowledge.schema.json#/$defs/record"
          },
          "minItems": 0,
          "maxItems": 2048
        },
        "previousEvidence": {
          "type": "array",
          "items": {
            "$ref": "project-knowledge.schema.json#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 8192
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 1,
          "maxItems": 32
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generationActor",
            "egress",
            "processSpawned"
          ],
          "properties": {
            "generationActor": {
              "const": "current-agent-session"
            },
            "egress": {
              "const": "none"
            },
            "processSpawned": {
              "const": false
            }
          }
        },
        "exchangeDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": "buildlore.knowledge-exchange.v2"
              }
            }
          },
          "then": {
            "required": [
              "authoringQuestions"
            ]
          },
          "else": {
            "not": {
              "required": [
                "authoringQuestions"
              ]
            }
          }
        }
      ]
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "runId",
        "phase",
        "active",
        "generationModel",
        "egress",
        "processSpawned"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.project-knowledge-workflow-status.v1"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "runId": {
          "type": "string",
          "pattern": "^run-[0-9a-f]{64}$"
        },
        "phase": {
          "enum": [
            "awaiting-proposal",
            "review-ready",
            "finalized",
            "approved"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "generationModel": {
          "const": "project-knowledge-v1"
        },
        "exchange": {
          "$ref": "#/$defs/exchange"
        },
        "proposal": {
          "$ref": "project-knowledge.schema.json#/$defs/proposal"
        },
        "reviewTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 16384
        },
        "authoringQuestions": {
          "$ref": "#/$defs/authoringQuestions"
        },
        "questionCoverage": {
          "$ref": "project-knowledge.schema.json#/$defs/questionCoverage"
        },
        "inspectionArgs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "sourceCoverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "coverage"
            ],
            "properties": {
              "id": {
                "$ref": "project-knowledge.schema.json#/$defs/identifier"
              },
              "coverage": {
                "oneOf": [
                  {
                    "$ref": "project-knowledge.schema.json#/$defs/evidenceCoverage"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requirementSelection": {
                "enum": [
                  "selected",
                  "unassessed"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "requirementSelection"
                  ],
                  "properties": {
                    "requirementSelection": {
                      "const": "unassessed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "coverage": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "coverage": {
                      "$ref": "project-knowledge.schema.json#/$defs/evidenceCoverage"
                    }
                  }
                }
              }
            ]
          }
        },
        "reviewViewDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        },
        "ledgerDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        },
        "generationDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        },
        "activationArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0,
          "maxItems": 16
        },
        "egress": {
          "const": "none"
        },
        "processSpawned": {
          "const": false
        },
        "developmentMemoryInspection": {
          "$ref": "project-knowledge-inspection.schema.json#/$defs/developmentMemoryInspection"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "runId",
        "revision",
        "phase",
        "outputLanguage",
        "snapshotDigest",
        "exchangeDigest",
        "baselineAuthorityDigest",
        "proposal",
        "semanticReview",
        "ledgerDigest",
        "approvedAuthorityDigest",
        "recordDigest"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "buildlore.project-knowledge-workflow-run.v1",
            "buildlore.project-knowledge-workflow-run.v2",
            "buildlore.project-knowledge-workflow-run.v3"
          ]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "runId": {
          "type": "string",
          "pattern": "^run-[0-9a-f]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "awaiting-proposal",
            "review-ready",
            "finalized",
            "approved"
          ]
        },
        "outputLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$"
        },
        "snapshotDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        },
        "exchangeDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        },
        "baselineAuthorityDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-knowledge.schema.json#/$defs/digest"
            }
          ]
        },
        "authoringQuestions": {
          "$ref": "#/$defs/authoringQuestions"
        },
        "questionAnswers": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/questionAnswers"
            }
          ]
        },
        "proposal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-knowledge.schema.json#/$defs/proposal"
            }
          ]
        },
        "semanticReview": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-knowledge.schema.json#/$defs/review"
            }
          ]
        },
        "ledgerDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-knowledge.schema.json#/$defs/digest"
            }
          ]
        },
        "approvedAuthorityDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "project-knowledge.schema.json#/$defs/digest"
            }
          ]
        },
        "recordDigest": {
          "$ref": "project-knowledge.schema.json#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": "buildlore.project-knowledge-workflow-run.v3"
              }
            }
          },
          "then": {
            "required": [
              "authoringQuestions",
              "questionAnswers"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "authoringQuestions"
                  ]
                },
                {
                  "required": [
                    "questionAnswers"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}

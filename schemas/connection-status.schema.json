{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.dev/schemas/connection-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connected",
    "readable",
    "projectId",
    "connectionDigest",
    "hubState",
    "knowledgeRevision",
    "pin",
    "dirty",
    "approval",
    "generation",
    "format",
    "readPolicy",
    "remote",
    "sourceRevisionComparison",
    "recoveryCommands"
  ],
  "properties": {
    "schemaVersion": {
      "const": "buildlore.connection-status.v1"
    },
    "connected": {
      "type": "boolean"
    },
    "readable": {
      "type": "boolean"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "not": {
            "enum": [
              "knowledge",
              "manifest",
              "projects",
              "shared"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "connectionDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hubState": {
      "enum": [
        "ready",
        "unavailable",
        "identity_mismatch"
      ]
    },
    "knowledgeRevision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pin": {
      "enum": [
        "matched",
        "mismatched",
        "conflicted",
        "uninitialized",
        "unknown"
      ]
    },
    "dirty": {
      "enum": [
        "clean",
        "dirty",
        "unknown"
      ]
    },
    "approval": {
      "enum": [
        "ready",
        "missing",
        "invalid",
        "unsupported"
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "enum": [
        "project-knowledge",
        "hierarchical",
        null
      ]
    },
    "readPolicy": {
      "const": "connected-approved"
    },
    "remote": {
      "const": "not_checked"
    },
    "sourceRevisionComparison": {
      "enum": [
        "match",
        "different",
        "unknown"
      ]
    },
    "recoveryCommands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      }
    },
    "knowledgeReview": {
      "$ref": "project-wiki.schema.json#/$defs/readMetadata"
    }
  }
}

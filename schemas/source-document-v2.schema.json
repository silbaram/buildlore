{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/source-document-v2.schema.json",
  "title": "BuildLore SourceDocument v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "title", "source", "ingestedAt", "body", "buildlore"],
  "dependentRequired": {
    "originalChars": ["truncated"],
    "truncated": ["originalChars"]
  },
  "properties": {
    "schemaVersion": { "const": "buildlore.source.v2" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\uD800-\\uDFFF]+$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[\\u0020-\\u007e]+$",
      "x-buildlore-equals": "buildlore.descriptor.sourceUri"
    },
    "ingestedAt": { "type": "string", "format": "date-time" },
    "sourceType": { "enum": ["web", "file", "image", "pdf", "transcript"] },
    "originalChars": {
      "description": "Original body length measured in Unicode scalar values.",
      "type": "integer",
      "minimum": 100001,
      "maximum": 9007199254740991
    },
    "truncated": { "const": true },
    "body": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100001,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\uD800-\\uDFFF])(?=[\\s\\S]*\\S)(?![\\s\\S]*\\n\\n$)[\\s\\S]*\\n$",
      "x-buildlore-contentHash": "buildlore.contentHash",
      "x-buildlore-truncatedPayloadLength": 100000
    },
    "buildlore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceKind",
        "producer",
        "projectId",
        "sourceRevision",
        "contentHash",
        "descriptor",
        "originMappings"
      ],
      "properties": {
        "schemaVersion": { "const": "buildlore.source.v2" },
        "sourceKind": {
          "enum": ["code", "markdown", "planning", "text"],
          "x-buildlore-equals": "descriptor.kind"
        },
        "producer": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "projectId": {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            { "not": { "enum": ["knowledge", "manifest", "projects", "shared"] } }
          ],
          "x-buildlore-equals": "descriptor.projectId"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "x-buildlore-equals": "descriptor.sourceRevision"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "x-buildlore-digestOf": "body"
        },
        "descriptor": { "$ref": "source-descriptor.schema.json" },
        "originMappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/rangeMapping" },
          "x-buildlore-boundedBy": "body",
          "x-buildlore-canonicalRanges": "strictly-ordered-non-overlapping"
        }
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endColumn", "endLine", "startColumn", "startLine"],
      "x-buildlore-orderedRange": true,
      "properties": {
        "endColumn": { "description": "One-based boundary measured in Unicode scalar values.", "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "startColumn": { "description": "One-based boundary measured in Unicode scalar values.", "type": "integer", "minimum": 1 },
        "startLine": { "type": "integer", "minimum": 1 }
      }
    },
    "rangeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "origin"],
      "x-buildlore-equalLineSpan": ["canonical", "origin"],
      "properties": {
        "canonical": { "$ref": "#/$defs/range" },
        "origin": { "$ref": "#/$defs/range" }
      }
    }
  }
}

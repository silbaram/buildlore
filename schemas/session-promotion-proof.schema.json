{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/session-promotion-proof.schema.json",
  "title": "BuildLore Session Promotion Proof V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "proofDigest", "projectId", "candidateId", "candidateDigest",
    "pageId", "profileMode", "bodyDigest", "titleDigest", "summaryDigest",
    "sourceRefsDigest", "citationsDigest", "contentHash", "sourceHashes",
    "citationBindings", "compilerSources"
  ],
  "properties": {
    "schemaVersion": { "const": "buildlore.session-promotion-proof.v1" },
    "proofDigest": { "$ref": "#/$defs/digest" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "candidateId": { "type": "string", "pattern": "^candidate-[a-f0-9]{64}$" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "pageId": { "type": "string", "pattern": "^(concepts|queries|decisions|failures|verifications)/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "profileMode": { "enum": ["custom", "default"] },
    "bodyDigest": { "$ref": "#/$defs/digest" },
    "titleDigest": { "$ref": "#/$defs/digest" },
    "summaryDigest": { "$ref": "#/$defs/digest" },
    "sourceRefsDigest": { "$ref": "#/$defs/digest" },
    "citationsDigest": { "$ref": "#/$defs/digest" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceHashes": { "type": "array", "maxItems": 4096, "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "citationBindings": { "type": "array", "maxItems": 512, "items": { "$ref": "session-review-candidate.schema.json#/$defs/citationBinding" } },
    "compilerSources": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "session-review-candidate.schema.json#/$defs/compilerSource" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

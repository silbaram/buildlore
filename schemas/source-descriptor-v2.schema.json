{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/source-descriptor-v2.schema.json",
  "title": "BuildLore Source Descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapterId",
    "adapterVersion",
    "contentHash",
    "declarationId",
    "inputBindings",
    "kind",
    "mediaType",
    "projectId",
    "projectionRevision",
    "schemaVersion",
    "sourceRef",
    "sourceRevision",
    "sourceUri"
  ],
  "properties": {
    "adapterConfigDigest": { "$ref": "#/$defs/digest" },
    "adapterRegistrationDigest": { "$ref": "#/$defs/digest" },
    "adapterId": { "$ref": "#/$defs/adapterId" },
    "adapterVersion": { "const": 1 },
    "contentHash": { "$ref": "#/$defs/digest" },
    "declarationId": { "$ref": "#/$defs/safeId" },
    "inputBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentHash", "sourceRef"],
        "properties": {
          "contentHash": { "$ref": "#/$defs/digest" },
          "sourceRef": { "$ref": "#/$defs/relativePath" }
        }
      },
      "x-buildlore-canonicalOrderBy": ["sourceRef", "contentHash"],
      "x-buildlore-uniqueBy": "sourceRef"
    },
    "kind": { "enum": ["code", "execution", "json", "markdown", "planning", "text"] },
    "mediaType": {
      "enum": [
        "application/json",
        "application/x-ndjson",
        "text/markdown",
        "text/plain",
        "text/x-source-code"
      ]
    },
    "metadata": { "$ref": "source-metadata.schema.json" },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentDigest", "id", "schemaVersion"],
      "properties": {
        "contentDigest": { "$ref": "#/$defs/digest" },
        "id": { "$ref": "#/$defs/adapterId" },
        "schemaVersion": { "$ref": "#/$defs/adapterId" }
      }
    },
    "projectId": { "$ref": "#/$defs/projectId" },
    "projectionRevision": { "$ref": "#/$defs/digest" },
    "schemaVersion": { "const": "buildlore.source-descriptor.v2" },
    "sourceRef": { "$ref": "#/$defs/relativePath" },
    "sourceRevision": {
      "$ref": "#/$defs/digest",
      "x-buildlore-equals": "projectionRevision"
    },
    "sourceUri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[\\u0020-\\u007e]+$"
    }
  },
  "$defs": {
    "adapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "projectId": {
      "allOf": [
        { "$ref": "#/$defs/safeId" },
        { "not": { "enum": ["knowledge", "manifest", "projects", "shared"] } }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*%)(?!.*//)(?!.*\\/$)(?!(?:[^/]+/){64})(?!\\.(?:/|$))(?!.*\\/\\.(?:/|$))(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!\\.git(?:/|$))(?!.*\\/\\.git(?:/|$))(?!\\.buildlore(?:/|$))(?!.*\\/\\.buildlore(?:/|$))(?!\\.llmwiki(?:/|$))(?!.*\\/\\.llmwiki(?:/|$))(?!(?:knowledge|projects|sources|wiki|export|exports)(?:/|$))(?!.*\\p{Cf})(?!.*(?:^|[/_.-])(?:[Aa][Pp][Ii][-_]?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][-_]?[Kk][Ee][Yy]|[Rr][Ee][Ff][Rr][Ee][Ss][Hh][-_]?[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt][Ss]?|[Tt][Oo][Kk][Ee][Nn][Ss]?|[Aa][Cc][Cc][Ee][Ss][Ss][-_]?[Tt][Oo][Kk][Ee][Nn])(?:$|[/_.-]))[^\\u0000-\\u001f\\u007f-\\u009f\\uD800-\\uDFFF]+$",
      "x-buildlore-maxSegments": 64,
      "x-buildlore-normalization": "NFC"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

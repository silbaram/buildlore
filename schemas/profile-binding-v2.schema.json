{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/profile-binding-v2.schema.json",
  "title": "BuildLore Profile Binding v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapters", "outputLanguage", "profileId", "schemaVersion", "upstreamProfile"],
  "properties": {
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapterId", "adapterVersion", "registrationDigest"],
        "properties": {
          "adapterId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "adapterVersion": { "const": 1 },
          "registrationDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "outputLanguage": { "enum": ["en", "ko"] },
    "profileId": { "enum": ["development", "general"] },
    "schemaVersion": { "const": "buildlore.profile-binding.v2" },
    "upstreamProfile": { "enum": ["custom", "default"] }
  },
  "allOf": [
    {
      "if": { "properties": { "profileId": { "const": "general" } } },
      "then": { "properties": { "upstreamProfile": { "const": "default" } } },
      "else": { "properties": { "upstreamProfile": { "const": "custom" } } }
    },
    {
      "properties": {
        "adapters": {
          "contains": {
            "type": "object",
            "required": ["adapterId"],
            "properties": { "adapterId": { "const": "buildlore.generic" } }
          }
        }
      }
    }
  ]
}

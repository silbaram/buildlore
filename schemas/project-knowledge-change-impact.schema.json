{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/project-knowledge-change-impact.schema.json",
  "title": "Read-only change impact on verified baseline knowledge",
  "description": "Runtime enforces verified history, current policy, expected identities, structural matching, stable ordering, digest and whole-fact UTF-8 byte budgets. This schema does not establish semantic support or approval.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/budgetFailure"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "lines"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pointer"
          ],
          "properties": {
            "kind": {
              "const": "json-pointer"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(|/(?:[^~]|~[01])*)$"
            }
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectedLine",
        "sourceRef",
        "jsonPointer",
        "range"
      ],
      "properties": {
        "projectedLine": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^(|/(?:[^~]|~[01])*)$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startLine",
            "startColumn",
            "endLine",
            "endColumn"
          ],
          "properties": {
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "startColumn": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "endColumn": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "projectId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "pattern": "^change-impact-(?:0|[1-9][0-9]{0,15})-[0-9a-f]{64}$"
    },
    "byteBudget": {
      "type": "integer",
      "minimum": 8192,
      "maximum": 1048576
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "projectId",
        "expectExchangeDigest",
        "expectSnapshotDigest",
        "expectBaselineGenerationDigest",
        "expectBaselineSnapshotDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-change-impact-request.v1"
        },
        "operation": {
          "const": "change-impact"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "expectExchangeDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectBaselineGenerationDigest": {
          "$ref": "#/$defs/digest"
        },
        "expectBaselineSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        },
        "maxBytes": {
          "$ref": "#/$defs/byteBudget",
          "default": 65536
        }
      }
    },
    "snapshotIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotDigest",
        "selectionDigest",
        "sanitizerPolicyDigest",
        "sanitizerRulesVersion"
      ],
      "properties": {
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerPolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerRulesVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generationDigest",
        "snapshotDigest",
        "selectionDigest",
        "sanitizerPolicyDigest",
        "sanitizerRulesVersion"
      ],
      "properties": {
        "generationDigest": {
          "$ref": "#/$defs/digest"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerPolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerRulesVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "sourceRevisionUnavailableReason",
        "repositoryRevision",
        "codeRevisionUnavailableReason",
        "origin",
        "evidenceId",
        "sourceId",
        "sourceRef",
        "sourceContentDigest",
        "sanitizedContentDigest",
        "sourceRevision",
        "codeRevision",
        "locator",
        "excerptDigest",
        "format"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceRevisionUnavailableReason": {
          "enum": [
            null,
            "not-provided-by-source-inventory"
          ]
        },
        "repositoryRevision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "codeRevisionUnavailableReason": {
          "enum": [
            null,
            "not-proven-by-source-inventory"
          ]
        },
        "origin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/origin"
            }
          ]
        },
        "evidenceId": {
          "$ref": "#/$defs/digest"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceContentDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizedContentDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "codeRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "excerptDigest": {
          "$ref": "#/$defs/digest"
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        }
      }
    },
    "dimension": {
      "enum": [
        "source-id",
        "source-ref",
        "source-content-digest",
        "sanitized-content-digest",
        "repository-revision",
        "source-revision",
        "code-revision",
        "format",
        "locator",
        "origin",
        "excerpt-digest"
      ]
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "sourceSelection",
        "disposition",
        "matchBasis",
        "changedDimensions",
        "candidateCount",
        "candidates"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/identity"
        },
        "sourceSelection": {
          "enum": [
            "selected",
            "unselected"
          ]
        },
        "disposition": {
          "enum": [
            "exact-current",
            "revision-metadata-changed",
            "same-excerpt-source-changed",
            "content-changed",
            "source-unselected",
            "aligned-evidence-unavailable",
            "ambiguous-current-candidates"
          ]
        },
        "matchBasis": {
          "enum": [
            "exact-evidence-id",
            "origin-json-pointer",
            "source-json-pointer",
            "source-line-locator",
            "none"
          ]
        },
        "changedDimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "maxItems": 11,
          "uniqueItems": true
        },
        "candidateCount": {
          "$ref": "#/$defs/count"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          },
          "maxItems": 8192
        }
      }
    },
    "claimLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageRole",
        "sectionIndex",
        "claimIndex",
        "claimId",
        "presentation"
      ],
      "properties": {
        "pageRole": {
          "enum": [
            "overview",
            "architecture",
            "decisions"
          ]
        },
        "sectionIndex": {
          "$ref": "#/$defs/count"
        },
        "claimIndex": {
          "$ref": "#/$defs/count"
        },
        "claimId": {
          "$ref": "#/$defs/identifier"
        },
        "presentation": {
          "enum": [
            "current",
            "history",
            "uncertainty"
          ]
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "recordDigest",
        "classification",
        "lifecycle",
        "reviewStatus",
        "supersededBy",
        "impactExtent",
        "conservativeCurrentnessEffect",
        "evidence",
        "baselineClaimLocations"
      ],
      "properties": {
        "factId": {
          "$ref": "#/$defs/digest"
        },
        "recordDigest": {
          "$ref": "#/$defs/digest"
        },
        "classification": {
          "enum": [
            "observed",
            "declared",
            "inferred"
          ]
        },
        "lifecycle": {
          "const": "current"
        },
        "reviewStatus": {
          "enum": [
            "proposed",
            "accepted",
            "disputed"
          ]
        },
        "supersededBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/digest"
          },
          "maxItems": 2048
        },
        "impactExtent": {
          "enum": [
            "partial-evidence",
            "all-evidence"
          ]
        },
        "conservativeCurrentnessEffect": {
          "const": "stale-without-reviewed-reproposal"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceLink"
          },
          "maxItems": 8192,
          "minItems": 1
        },
        "baselineClaimLocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claimLocation"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineRecords",
        "currentRecords",
        "affectedFacts",
        "retainedCurrentFacts",
        "excludedHistorical",
        "excludedSuperseded",
        "excludedStale",
        "baselineEvidenceLinks",
        "nonExactEvidenceLinks"
      ],
      "properties": {
        "baselineRecords": {
          "$ref": "#/$defs/count"
        },
        "currentRecords": {
          "$ref": "#/$defs/count"
        },
        "affectedFacts": {
          "$ref": "#/$defs/count"
        },
        "retainedCurrentFacts": {
          "$ref": "#/$defs/count"
        },
        "excludedHistorical": {
          "$ref": "#/$defs/count"
        },
        "excludedSuperseded": {
          "$ref": "#/$defs/count"
        },
        "excludedStale": {
          "$ref": "#/$defs/count"
        },
        "baselineEvidenceLinks": {
          "$ref": "#/$defs/count"
        },
        "nonExactEvidenceLinks": {
          "$ref": "#/$defs/count"
        }
      },
      "description": "Whole comparison counts, independent of pagination. Evidence-link counts cover the baseline current records compared, including exact siblings; other lifecycles are counted as excluded."
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedSnapshotOnly",
        "checkoutWideVerification",
        "semanticReviewPerformed",
        "knowledgeMutation",
        "approvalEffect",
        "egress",
        "processSpawned"
      ],
      "properties": {
        "selectedSnapshotOnly": {
          "const": true
        },
        "checkoutWideVerification": {
          "const": false
        },
        "semanticReviewPerformed": {
          "const": false
        },
        "knowledgeMutation": {
          "const": "none"
        },
        "approvalEffect": {
          "const": "none"
        },
        "egress": {
          "const": "none"
        },
        "processSpawned": {
          "const": false
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "projectId",
        "exchangeDigest",
        "currentSnapshot",
        "baseline",
        "comparisonPolicyVersion",
        "summary",
        "impacts",
        "total",
        "cursor",
        "status",
        "minimumRequiredBytes",
        "byteBudget",
        "maximumBytes",
        "retryable",
        "instructions",
        "boundary",
        "resultDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-change-impact.v1"
        },
        "operation": {
          "const": "change-impact"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "exchangeDigest": {
          "$ref": "#/$defs/digest"
        },
        "currentSnapshot": {
          "$ref": "#/$defs/snapshotIdentity"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "comparisonPolicyVersion": {
          "const": "conservative-change-impact-v1"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "impacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/impact"
          },
          "maxItems": 50
        },
        "total": {
          "$ref": "#/$defs/count"
        },
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "status": {
          "enum": [
            "ready",
            "empty",
            "item-too-large"
          ]
        },
        "minimumRequiredBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 8192
        },
        "byteBudget": {
          "$ref": "#/$defs/byteBudget"
        },
        "maximumBytes": {
          "const": 1048576
        },
        "retryable": {
          "type": "boolean"
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 16
        },
        "boundary": {
          "$ref": "#/$defs/boundary"
        },
        "resultDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "item-too-large"
              }
            }
          },
          "then": {
            "properties": {
              "impacts": {
                "maxItems": 0
              },
              "cursor": {
                "type": "string"
              },
              "minimumRequiredBytes": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "minimumRequiredBytes": {
                "const": null
              },
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "empty"
              }
            }
          },
          "then": {
            "properties": {
              "impacts": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "impacts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "budgetFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reason",
        "byteBudget",
        "minimumRequiredBytes",
        "maximumBytes",
        "retryable"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-change-impact-budget.v1"
        },
        "reason": {
          "const": "response-metadata-too-large"
        },
        "byteBudget": {
          "$ref": "#/$defs/byteBudget"
        },
        "minimumRequiredBytes": {
          "type": "integer",
          "minimum": 8192
        },
        "maximumBytes": {
          "const": 1048576
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}

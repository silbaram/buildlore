{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/compile-apply-result.schema.json",
  "title": "BuildLore Session Compile Apply Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "planDigest",
    "batchDigest",
    "outcome",
    "reviewRequired",
    "admissionKind",
    "admittedCount",
    "heldCount",
    "skippedCount",
    "candidateRefs",
    "sideEffectsPossible",
    "recoveryAction",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "buildlore.compile-apply-result.v1" },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "planDigest": { "$ref": "#/$defs/digest" },
    "batchDigest": { "$ref": "#/$defs/digest" },
    "outcome": { "const": "staged" },
    "reviewRequired": { "const": true },
    "admissionKind": { "const": "buildlore-review" },
    "admittedCount": { "type": "integer", "minimum": 1, "maximum": 50 },
    "heldCount": { "type": "integer", "minimum": 1, "maximum": 50 },
    "skippedCount": { "const": 0 },
    "candidateRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 260 }
    },
    "sideEffectsPossible": { "const": false },
    "recoveryAction": { "const": "review" },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

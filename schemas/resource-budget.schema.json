{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-budget.schema.json",
  "title": "Content-free resource budget diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "resource",
    "observed",
    "maximum",
    "recoveryAction"
  ],
  "properties": {
    "schemaVersion": {
      "const": "buildlore.resource-budget.v1"
    },
    "stage": {
      "enum": [
        "legacy-session-sources",
        "legacy-session-plan",
        "wiki-sources",
        "knowledge-input",
        "knowledge-snapshot",
        "knowledge-generation",
        "wiki-state",
        "wiki-run"
      ]
    },
    "resource": {
      "enum": [
        "utf8-bytes",
        "sources",
        "evidence",
        "json-nodes",
        "json-depth"
      ]
    },
    "observed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maximum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recoveryAction": {
      "const": "review-resource-budget-without-dropping-required-content"
    }
  }
}

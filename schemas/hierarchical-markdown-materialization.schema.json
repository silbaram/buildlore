{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/hierarchical-markdown-materialization.schema.json",
  "title": "BuildLore deterministic hierarchical Markdown materialization contracts",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/status" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "indexFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "kind", "path", "sha256"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "kind": { "const": "index" },
        "path": { "const": "index.md" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "pageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteLength", "kind", "pageId", "path", "proposalDigest", "sha256"],
      "properties": {
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "kind": { "const": "page" },
        "pageId": { "type": "string", "pattern": "^page-[a-f0-9]{64}$" },
        "path": { "type": "string", "pattern": "^page-[a-f0-9]{64}\\.md$" },
        "proposalDigest": { "$ref": "#/$defs/digest" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "projectId", "authorityDigest", "recordDigest",
        "projectionDigest", "corpusDigest", "generationDigest", "sanitizerPolicyDigest",
        "rendererDigest", "pageCount", "files", "materializationDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.hierarchical-markdown-materialization-manifest.v1"
        },
        "projectId": { "$ref": "#/$defs/projectId" },
        "authorityDigest": { "$ref": "#/$defs/digest" },
        "recordDigest": { "$ref": "#/$defs/digest" },
        "projectionDigest": { "$ref": "#/$defs/digest" },
        "corpusDigest": { "$ref": "#/$defs/digest" },
        "generationDigest": { "$ref": "#/$defs/digest" },
        "sanitizerPolicyDigest": { "$ref": "#/$defs/digest" },
        "rendererDigest": { "$ref": "#/$defs/digest" },
        "pageCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4097,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/indexFile" },
              { "$ref": "#/$defs/pageFile" }
            ]
          },
          "x-buildlore-canonicalOrderBy": "path",
          "x-buildlore-uniqueBy": "path"
        },
        "materializationDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "recoveryAction": {
      "prefixItems": [
        { "const": "compile" },
        { "const": "activate" },
        { "const": "--project" },
        { "$ref": "#/$defs/projectId" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "projectId", "state"],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.hierarchical-markdown-materialization-status.v1"
            },
            "projectId": { "$ref": "#/$defs/projectId" },
            "state": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "projectId", "state", "reasonCode", "recoveryAction"],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.hierarchical-markdown-materialization-status.v1"
            },
            "projectId": { "$ref": "#/$defs/projectId" },
            "state": { "enum": ["missing", "drifted", "invalid"] },
            "reasonCode": {
              "enum": [
                "materialization-missing",
                "materialization-drifted",
                "materialization-invalid"
              ]
            },
            "recoveryAction": { "$ref": "#/$defs/recoveryAction" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion", "projectId", "state", "generationDigest",
            "materializationDigest", "pageCount", "fileCount"
          ],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.hierarchical-markdown-materialization-status.v1"
            },
            "projectId": { "$ref": "#/$defs/projectId" },
            "state": { "const": "ready" },
            "generationDigest": { "$ref": "#/$defs/digest" },
            "materializationDigest": { "$ref": "#/$defs/digest" },
            "pageCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "fileCount": { "type": "integer", "minimum": 1, "maximum": 4097 }
          }
        }
      ]
    }
  },
  "x-buildlore-authority": "derived-projection-only",
  "x-buildlore-projectIsolation": true,
  "x-buildlore-providerCalls": 0,
  "x-buildlore-egress": "none"
}

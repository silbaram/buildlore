{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.dev/schemas/cli-envelope-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "ok",
    "projectId",
    "workspacePath",
    "knowledgeRevision",
    "data",
    "partial",
    "warnings",
    "errors",
    "readContext"
  ],
  "properties": {
    "schemaVersion": {
      "const": "buildlore.cli-envelope.v2"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "ok": {
      "type": "boolean"
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "not": {
            "enum": [
              "knowledge",
              "manifest",
              "projects",
              "shared"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "workspacePath": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "knowledgeRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {},
    "partial": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "recoveryCommand": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "reasonCode": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "recoveryCommand": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            }
          }
        }
      }
    },
    "readContext": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "knowledgeRepositoryDigest",
            "format",
            "generation",
            "readPolicy"
          ],
          "properties": {
            "knowledgeRepositoryDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "format": {
              "enum": [
                "project-knowledge",
                "hierarchical"
              ]
            },
            "generation": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "readPolicy": {
              "const": "connected-approved"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

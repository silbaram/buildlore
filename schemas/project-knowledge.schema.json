{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/project-knowledge.schema.json",
  "title": "Project knowledge, provenance and semantic review contracts",
  "description": "Schema validates shape, not semantic truth or persistence authority. Runtime enforces exact locators, canonical digests, evidence membership, lifecycle and independent review. Serialized JSON has a 16 MiB bound; string byte bounds can be stricter than character bounds.",
  "x-buildlore-maxUtf8Bytes": 16777216,
  "oneOf": [
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/proposal"
    },
    {
      "$ref": "#/$defs/review"
    },
    {
      "$ref": "#/$defs/generation"
    },
    {
      "$ref": "#/$defs/factSupport"
    },
    {
      "$ref": "#/$defs/evidenceCoverage"
    },
    {
      "$ref": "#/$defs/groundingDiagnostic"
    },
    {
      "$ref": "#/$defs/questionCoverage"
    },
    {
      "$ref": "#/$defs/proposalV2"
    },
    {
      "$ref": "#/$defs/generationV3"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "questionCoverageInput": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "description": "Caller-defined authoring questions; at most 256 requirements in total. A mapping does not establish semantic completeness.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claimIds",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
          },
          "claimIds": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
            }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sourceRef",
                "jsonPointer",
                "contentKind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "jsonPointer": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4096
                },
                "contentKind": {
                  "enum": [
                    "any",
                    "json-value",
                    "text"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "questionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "snapshotDigest",
        "proposalDigest",
        "requirementsDigest",
        "semanticReviewRequired",
        "questions",
        "complete",
        "coverageDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-question-coverage.v1"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "proposalDigest": {
          "$ref": "#/$defs/digest"
        },
        "requirementsDigest": {
          "$ref": "#/$defs/digest"
        },
        "semanticReviewRequired": {
          "const": true
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claimIds",
              "requirements",
              "complete"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "claimIds": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "complete": {
                "type": "boolean"
              },
              "requirements": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status",
                    "evidenceIds",
                    "citedEvidenceIds"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "status": {
                      "enum": [
                        "covered",
                        "uncited",
                        "heading-only",
                        "unavailable"
                      ]
                    },
                    "evidenceIds": {
                      "type": "array",
                      "maxItems": 8192,
                      "items": {
                        "$ref": "#/$defs/digest"
                      }
                    },
                    "citedEvidenceIds": {
                      "type": "array",
                      "maxItems": 8192,
                      "items": {
                        "$ref": "#/$defs/digest"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "coverageDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "factSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "generationDigest",
        "snapshotDigest",
        "selectionDigest",
        "baselineGenerationDigest",
        "fact",
        "presentEvidenceIds",
        "absentEvidenceIds",
        "supportDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-fact-support.v1"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "generationDigest": {
          "$ref": "#/$defs/digest"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "selectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "baselineGenerationDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "fact": {
          "$ref": "#/$defs/record"
        },
        "presentEvidenceIds": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "absentEvidenceIds": {
          "type": "array",
          "maxItems": 8192,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "supportDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "evidenceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "snapshotDigest",
        "requirements",
        "complete",
        "coverageDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-evidence-coverage.v1"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidenceIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "available",
                  "heading-only",
                  "unavailable"
                ]
              },
              "evidenceIds": {
                "type": "array",
                "maxItems": 8192,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "coverageDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "groundingDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "snapshotDigest",
        "proposalDigest",
        "semanticReviewRequired",
        "claims",
        "diagnosticDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-grounding-diagnostic.v1"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "proposalDigest": {
          "$ref": "#/$defs/digest"
        },
        "semanticReviewRequired": {
          "const": true
        },
        "claims": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claimId",
              "overlapBasisPoints",
              "minimumBasisPoints",
              "lexicalCheckPassed"
            ],
            "properties": {
              "claimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "overlapBasisPoints": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "minimumBasisPoints": {
                "const": 2500
              },
              "lexicalCheckPassed": {
                "type": "boolean"
              }
            }
          }
        },
        "diagnosticDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "authorityExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "generationDigest",
        "generations",
        "pageMappings",
        "evidenceMappings",
        "extensionDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-authority-extension.v1"
        },
        "generationDigest": {
          "$ref": "#/$defs/digest"
        },
        "generations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generation"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "pageMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "pageId",
              "claims"
            ],
            "properties": {
              "role": {
                "enum": [
                  "overview",
                  "architecture",
                  "decisions"
                ]
              },
              "pageId": {
                "type": "string",
                "pattern": "^page-[0-9a-f]{64}$"
              },
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "claimId",
                    "hierarchyClaimId",
                    "factIds"
                  ],
                  "properties": {
                    "claimId": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,255}$"
                    },
                    "hierarchyClaimId": {
                      "type": "string",
                      "pattern": "^claim-[0-9a-f]{64}$"
                    },
                    "factIds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/digest"
                      },
                      "minItems": 1,
                      "maxItems": 2048
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 8192
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "evidenceMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceId",
              "unitId",
              "citationId"
            ],
            "properties": {
              "evidenceId": {
                "$ref": "#/$defs/digest"
              },
              "unitId": {
                "type": "string",
                "pattern": "^unit-[0-9a-f]{64}$"
              },
              "citationId": {
                "type": "string",
                "pattern": "^citation-[0-9a-f]{64}$"
              }
            }
          },
          "minItems": 1,
          "maxItems": 8192
        },
        "extensionDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "recordsExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "generationDigest",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-records.v1"
        },
        "projectId": {
          "$ref": "#/$defs/snapshot/properties/projectId"
        },
        "generationDigest": {
          "$ref": "#/$defs/digest"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "minItems": 0,
          "maxItems": 2048
        }
      }
    },
    "evidenceExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "generationDigest",
        "evidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-evidence-manifest.v1"
        },
        "projectId": {
          "$ref": "#/$defs/snapshot/properties/projectId"
        },
        "generationDigest": {
          "$ref": "#/$defs/digest"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0,
          "maxItems": 8192
        }
      }
    },
    "repositoryRevision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "model",
        "kind"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "agent",
            "human"
          ]
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "lines"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pointer"
          ],
          "properties": {
            "kind": {
              "const": "json-pointer"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(|/(?:[^~]|~[01])*)$"
            }
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectedLine",
        "sourceRef",
        "range"
      ],
      "properties": {
        "projectedLine": {
          "type": "integer",
          "minimum": 1
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^(|/(?:[^~]|~[01])*)$"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startLine",
            "startColumn",
            "endLine",
            "endColumn"
          ],
          "properties": {
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "startColumn": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "endColumn": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceRef",
        "sourceContentDigest",
        "sourceRevision",
        "codeRevision",
        "tracked",
        "format",
        "content"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceContentDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "codeRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "tracked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "repositoryRevision": {
          "$ref": "#/$defs/repositoryRevision"
        },
        "origins": {
          "type": "array",
          "maxItems": 8192,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/origin"
              },
              {
                "required": [
                  "jsonPointer"
                ]
              }
            ]
          }
        },
        "format": {
          "enum": [
            "markdown",
            "json"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144,
          "x-buildlore-maxUtf8Bytes": 262144
        },
        "chunk": {
          "$ref": "source-document-v4.schema.json#/properties/buildlore/properties/chunk"
        },
        "originMappings": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "source-document-v4.schema.json#/$defs/rangeMapping"
          }
        }
      },
      "dependentRequired": {
        "chunk": [
          "originMappings"
        ],
        "originMappings": [
          "chunk"
        ]
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "evidenceId",
        "sourceId",
        "sourceRef",
        "sourceContentDigest",
        "sanitizedContentDigest",
        "sourceRevision",
        "codeRevision",
        "sourceRevisionUnavailableReason",
        "codeRevisionUnavailableReason",
        "locator",
        "excerpt",
        "excerptDigest"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceRevisionUnavailableReason": {
          "enum": [
            null,
            "not-provided-by-source-inventory"
          ]
        },
        "repositoryRevision": {
          "$ref": "#/$defs/repositoryRevision"
        },
        "codeRevisionUnavailableReason": {
          "enum": [
            null,
            "not-proven-by-source-inventory"
          ]
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "evidenceId": {
          "$ref": "#/$defs/digest"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sourceContentDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizedContentDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "codeRevision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "excerptDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "selectionDigest",
        "sanitizerPolicyDigest",
        "sanitizerRulesVersion",
        "sources",
        "evidence",
        "snapshotDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.knowledge-snapshot.v1"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "selectionDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerPolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "sanitizerRulesVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "maxItems": 2048,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 8192,
          "minItems": 0
        },
        "snapshotDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "statement",
        "scope",
        "classification",
        "lifecycle",
        "evidenceIds",
        "observation",
        "id",
        "projectId",
        "reviewStatus",
        "supersededBy",
        "derivation",
        "recordDigest"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "predicate": {
          "anyOf": [
            {

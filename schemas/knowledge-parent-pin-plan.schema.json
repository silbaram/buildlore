{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.local/schemas/knowledge-parent-pin-plan.schema.json",
  "title": "BuildLore Parent Knowledge Pin Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "intent", "iterationId", "path",
    "parentRepositoryIdentityDigest", "knowledgeRepositoryIdentityDigest",
    "parentBaseRevision", "codeRevision", "oldKnowledgeGitlink", "newKnowledgeGitlink",
    "projectId", "sourceRevision", "lineageDigest", "targetRemoteReachability",
    "noOp", "eligible", "blockReasons", "planDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "buildlore.parent-knowledge-pin-plan.v1" },
    "intent": { "const": "iteration-close" },
    "iterationId": { "$ref": "#/$defs/iterationId" },
    "path": { "const": "knowledge" },
    "parentRepositoryIdentityDigest": { "$ref": "#/$defs/digest" },
    "knowledgeRepositoryIdentityDigest": { "$ref": "#/$defs/digest" },
    "parentBaseRevision": { "$ref": "#/$defs/oid" },
    "codeRevision": { "$ref": "#/$defs/oid" },
    "oldKnowledgeGitlink": { "$ref": "#/$defs/oid" },
    "newKnowledgeGitlink": { "$ref": "#/$defs/oid" },
    "projectId": { "oneOf": [{ "$ref": "#/$defs/projectId" }, { "type": "null" }] },
    "sourceRevision": { "oneOf": [{ "$ref": "#/$defs/oid" }, { "type": "null" }] },
    "lineageDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "targetRemoteReachability": { "type": "boolean" },
    "noOp": { "type": "boolean" },
    "eligible": { "type": "boolean" },
    "blockReasons": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KNOWLEDGE_DIRTY", "KNOWLEDGE_HEAD_MISMATCH", "KNOWLEDGE_LINEAGE_INVALID",
          "KNOWLEDGE_REMOTE_MISSING", "KNOWLEDGE_REMOTE_UNREADABLE",
          "KNOWLEDGE_REMOTE_UNREACHABLE", "PARENT_CODE_MISMATCH", "PARENT_DIRTY"
        ]
      }
    },
    "planDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "iterationId": {
      "type": "string", "minLength": 1, "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "projectId": {
      "type": "string", "minLength": 1, "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}

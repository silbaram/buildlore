{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildlore.dev/schemas/workspace-publish-result.schema.json",
  "title": "BuildLore Knowledge Publish Result v1",
  "oneOf": [
    {
      "$ref": "#/$defs/blocked"
    },
    {
      "$ref": "#/$defs/committed"
    },
    {
      "$ref": "#/$defs/pushed"
    },
    {
      "$ref": "#/$defs/pushFailed"
    }
  ],
  "$defs": {
    "oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staged",
        "unstaged",
        "untracked"
      ],
      "properties": {
        "staged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "unstaged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "untracked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "schemaVersion",
        "state",
        "projectId",
        "baseRevision",
        "foreignCounts",
        "knowledgeRevision",
        "localCommitPreserved",
        "partial",
        "pinRequired",
        "recoveryCommand",
        "remoteRevision",
        "stagedPaths",
        "treeRevision",
        "warnings",
        "parentPin"
      ],
      "properties": {
        "schemaVersion": {
          "const": "buildlore.workspace-publish-result.v1"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        },
        "baseRevision": {
          "$ref": "#/$defs/oid"
        },
        "foreignCounts": {
          "$ref": "#/$defs/counts"
        },
        "knowledgeRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "localCommitPreserved": {
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "pinRequired": {
          "const": false
        },
        "recoveryCommand": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "remoteRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "stagedPaths": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "treeRevision": {
          "oneOf": [
            {
              "$ref": "#/$defs/oid"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "parentPin": {
          "const": "not_applicable"
        }
      }
    },
    "blocked": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "state",
            "projectId",
            "baseRevision",
            "errorCode",
            "foreignCounts",
            "knowledgeRevision",
            "localCommitPreserved",
            "partial",
            "pinRequired",
            "recoveryCommand",
            "remoteRevision",
            "stagedPaths",
            "treeRevision",
            "warnings",
            "parentPin"
          ],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.workspace-publish-result.v1"
            },
            "projectId": true,
            "baseRevision": true,
            "foreignCounts": true,
            "knowledgeRevision": true,
            "localCommitPreserved": true,
            "partial": true,
            "pinRequired": {
              "const": false
            },
            "recoveryCommand": true,
            "remoteRevision": true,
            "stagedPaths": true,
            "treeRevision": true,
            "warnings": true,
            "state": {
              "const": "blocked"
            },
            "errorCode": {
              "enum": [
                "PUBLISH_DIRTY_INDEX",
                "PUBLISH_COMMIT_INVALID",
                "PUBLISH_INELIGIBLE",
                "PUBLISH_PARTIAL",
                "PUBLISH_PATH_DRIFT",
                "PUBLISH_PLAN_DRIFT",
                "PUBLISH_POLICY_BLOCKED",
                "PUBLISH_REPOSITORY_DRIFT",
                "PUBLISH_REMOTE_AHEAD",
                "PUBLISH_REMOTE_DIVERGED",
                "PUBLISH_REMOTE_MISSING",
                "PUBLISH_REMOTE_RACE",
                "PUBLISH_REMOTE_UNREADABLE",
                "PUBLISH_REFERENCE_DRIFT",
                "PUBLISH_REPOSITORY_BUSY",
                "PUBLISH_TRANSACTION_FAILED"
              ]
            },
            "parentPin": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "committed": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "state",
            "projectId",
            "baseRevision",
            "foreignCounts",
            "knowledgeRevision",
            "localCommitPreserved",
            "partial",
            "pinRequired",
            "recoveryCommand",
            "remoteRevision",
            "stagedPaths",
            "treeRevision",
            "warnings",
            "parentPin"
          ],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.workspace-publish-result.v1"
            },
            "projectId": true,
            "baseRevision": true,
            "foreignCounts": true,
            "knowledgeRevision": {
              "$ref": "#/$defs/oid"
            },
            "localCommitPreserved": {
              "const": true
            },
            "partial": {
              "const": false
            },
            "pinRequired": {
              "const": false
            },
            "recoveryCommand": true,
            "remoteRevision": {
              "type": "null"
            },
            "stagedPaths": true,
            "treeRevision": {
              "$ref": "#/$defs/oid"
            },
            "warnings": true,
            "state": {
              "const": "committed"
            },
            "parentPin": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "pushed": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "state",
            "projectId",
            "baseRevision",
            "foreignCounts",
            "knowledgeRevision",
            "localCommitPreserved",
            "partial",
            "pinRequired",
            "recoveryCommand",
            "remoteRevision",
            "stagedPaths",
            "treeRevision",
            "warnings",
            "parentPin"
          ],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.workspace-publish-result.v1"
            },
            "projectId": true,
            "baseRevision": true,
            "foreignCounts": true,
            "knowledgeRevision": {
              "$ref": "#/$defs/oid"
            },
            "localCommitPreserved": {
              "const": true
            },
            "partial": {
              "const": false
            },
            "pinRequired": {
              "const": false
            },
            "recoveryCommand": true,
            "remoteRevision": {
              "$ref": "#/$defs/oid"
            },
            "stagedPaths": true,
            "treeRevision": {
              "$ref": "#/$defs/oid"
            },
            "warnings": true,
            "state": {
              "const": "pushed"
            },
            "parentPin": {
              "const": "not_applicable"
            }
          }
        }
      ]
    },
    "pushFailed": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "state",
            "projectId",
            "baseRevision",
            "errorCode",
            "foreignCounts",
            "knowledgeRevision",
            "localCommitPreserved",
            "partial",
            "pinRequired",
            "recoveryCommand",
            "remoteRevision",
            "stagedPaths",
            "treeRevision",
            "warnings",
            "parentPin"
          ],
          "properties": {
            "schemaVersion": {
              "const": "buildlore.workspace-publish-result.v1"
            },
            "projectId": true,
            "baseRevision": true,
            "foreignCounts": true,
            "knowledgeRevision": {
              "$ref": "#/$defs/oid"
            },
            "localCommitPreserved": {
              "const": true
            },
            "partial": {
              "const": true
            },
            "pinRequired": {
              "const": false
            },
            "recoveryCommand": true,
            "remoteRevision": {
              "$ref": "#/$defs/oid"
            },
            "stagedPaths": true,
            "treeRevision": {
              "$ref": "#/$defs/oid"
            },
            "warnings": true,
            "state": {
              "const": "push-failed"
            },
            "errorCode": {
              "const": "PUBLISH_PUSH_FAILED"
            },
            "parentPin": {
              "const": "not_applicable"
            }
          }
        }
      ]
    }
  }
}

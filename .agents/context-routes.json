      "condition": "Gate A intake is authored, validated, approved, or resumed.",
      "stages": [
        "gate-a"
      ]
    },
    {
      "id": "schema.gate-a-reference-bundle-snapshot",
      "owner": "schema",
      "root": "runtime",
      "path": "schemas/reference-bundle-snapshot.schema.json",

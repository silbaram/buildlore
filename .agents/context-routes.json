    {
      "id": "schema.next-contract",
      "owner": "schema",
      "root": "runtime",
      "path": "schemas/next-v2.schema.json",
      "condition": "An agent requests the typed p2a next v2 contract.",
      "stages": [
        "entry",
        "gate-a",
        "gate-shape",
        "gate-b",
        "gate-c",
        "execution",
        "visual",
        "acceptance",
        "monitor",
        "closeout"
      ]
    },

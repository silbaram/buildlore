      "owner": "cli",
      "root": "runtime",
      "path": "scripts/p2a.mjs",
      "condition": "The current canonical state is inspected or routed to one next action.",
      "stages": [
        "entry",
        "gate-a",
        "gate-shape",
        "gate-b",
        "gate-c",
        "execution",
        "visual",
        "acceptance",
        "monitor",
        "closeout"
      ]
    },
    {
      "id": "cli.artifact-validator",
      "owner": "cli",
      "root": "runtime",
      "path": "scripts/validate_artifacts.mjs",
      "condition": "A canonical planning, execution, visual, or review artifact is validated.",
      "stages": [
        "entry",
        "gate-a",
        "gate-shape",
        "gate-b",
        "gate-c",
        "execution",
        "visual",
        "acceptance",
        "monitor",
        "closeout"
      ]
    },
    {
      "id": "hook.claude-workspace-confinement",
      "owner": "hook",
      "root": "target",
      "path": ".claude/hooks/p2a-confine-workspace.mjs",
